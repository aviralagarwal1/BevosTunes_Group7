@model BevosTunesMVC.Models.Customer
@{ ViewData["Title"] = "Edit Profile"; }

<h2>Edit Profile</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="post" asp-controller="Account" asp-action="Edit" class="mt-3" novalidate>
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">First Name</label>
            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" name="lastName" class="form-control" value="@Model.LastName" required />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="@Model.Email" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone Number</label>
        <input type="tel" name="phoneNumber" class="form-control" value="@Model.PhoneNumber"
               required maxlength="14" inputmode="tel"
               pattern="\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}"
               title="Enter a 10-digit phone number."
               placeholder="e.g. (512) 555-1234" />
    </div>

    <div class="mb-3">
        <label class="form-label">Street Address</label>
        <input type="text" name="street" class="form-control" value="@Model.Street" required />
    </div>

    <div class="mb-3">
        <label class="form-label">ZIP Code</label>
        <input type="text" name="zipCode" class="form-control" value="@Model.ZipCode" required maxlength="10" />
        <div class="form-text">City and state are automatically determined from ZIP code (currently: @Model.City, @Model.State).</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a class="btn btn-secondary" asp-action="Details">Cancel</a>
    </div>
</form>
