@model IEnumerable<BevosTunesMVC.Models.CreditCard>
@{ ViewData["Title"] = "Credit Cards"; }

<h2>Credit Cards</h2>
<p class="text-muted">You may store up to 2 credit cards.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

@if (Model.Any())
{
    <table class="table table-striped table-sm mt-3">
        <thead class="table-dark">
            <tr>
                <th>Type</th>
                <th>Number</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model)
            {
                <tr>
                    <td>@card.DisplayCardType</td>
                    <td>**** **** **** @card.CardNumber[^4..]</td>
                    <td>
                        <a class="btn btn-sm btn-danger" asp-action="ConfirmRemoveCard" asp-route-cardId="@card.CreditCardID">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3 text-muted">No credit cards on file.</p>
}

@if (Model.Count() < 2)
{
    <h5 class="mt-4">Add a Card</h5>
    <form method="post" asp-action="AddCard" class="mt-2" style="max-width:400px" novalidate>
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Card Number</label>
            <input type="text" name="cardNumber" class="form-control" required inputmode="numeric"
                   value="@ViewBag.CardNumber"
                   autocomplete="cc-number" maxlength="16" minlength="15" pattern="[0-9]{15,16}"
                   title="Enter 15 or 16 digits."
                   placeholder="e.g. 4242424242424242" />
            <div class="form-text">Card type is auto-detected. Visa starts with 4, Mastercard with 54, Discover with 6, and Amex uses 15 digits.</div>
        </div>
        <button type="submit" class="btn btn-primary">Add Card</button>
    </form>
}

<div class="mt-4">
    <a class="btn btn-secondary" asp-action="Details">Back to Account</a>
</div>
