@model BevosTunesMVC.Models.Customer
@{ ViewData["Title"] = "My Account"; }

<h2>My Account</h2>

<dl class="row mt-3">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Street, @Model.City, @Model.State @Model.ZipCode</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-danger">Disabled</span>
        }
    </dd>
</dl>

<div class="mt-3 d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" asp-action="Edit">Edit Profile</a>
    <a class="btn btn-secondary" asp-action="ChangePassword">Change Password</a>
    <a class="btn btn-secondary" asp-action="CreditCards">Manage Credit Cards</a>
</div>
