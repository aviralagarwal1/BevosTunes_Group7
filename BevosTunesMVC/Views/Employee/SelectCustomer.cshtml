@model IEnumerable<BevosTunesMVC.Models.Customer>
@{ ViewData["Title"] = "Purchase for Customer"; }

<h2>Purchase on Behalf of Customers</h2>
<p class="text-muted">Select a customer to shop as. You will be redirected to their cart to complete a purchase.</p>

<table class="table table-striped table-sm mt-3">
    <thead class="table-dark">
        <tr><th>Name</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.FirstName @c.LastName</td>
                <td>@c.Email</td>
                <td>
                    <form method="post" asp-action="ImpersonateCustomer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@c.CustomerID" />
                        <button type="submit" class="btn btn-sm btn-primary">Select</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<a class="btn btn-secondary" asp-action="Dashboard">Back</a>
