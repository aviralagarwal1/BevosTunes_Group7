@model IEnumerable<BevosTunesMVC.Models.Customer>
@{ ViewData["Title"] = "Customer Management"; }

<h2>Customers <span class="badge bg-secondary">@Model.Count()</span></h2>
<a class="btn btn-success btn-sm mb-3" asp-action="CreateCustomer">+ Create Customer</a>

<table class="table table-striped table-sm">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>City, State</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.FirstName @c.LastName</td>
                <td>@c.Email</td>
                <td>@c.PhoneNumber</td>
                <td>@c.City, @c.State</td>
                <td>
                    @if (c.IsActive)
                    { <span class="badge bg-success">Active</span> }
                    else
                    { <span class="badge bg-danger">Disabled</span> }
                </td>
                <td class="d-flex gap-1">
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditCustomer" asp-route-id="@c.CustomerID">Edit</a>
                    <form method="post" asp-action="ToggleCustomer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@c.CustomerID" />
                        <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(c.IsActive ? "Disable" : "Enable")
                        </button>
                    </form>
                    <form method="post" asp-action="ImpersonateCustomer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@c.CustomerID" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Shop As</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<a class="btn btn-secondary" asp-action="Dashboard">Back</a>
