@using BevosTunesMVC.Models
@{
    ViewData["Title"] = "Pending Reviews";
    var songReviews   = ViewBag.SongReviews   as List<SongReview>   ?? new();
    var albumReviews  = ViewBag.AlbumReviews  as List<AlbumReview>  ?? new();
    var artistReviews = ViewBag.ArtistReviews as List<ArtistReview> ?? new();
}

<h2>Pending Reviews</h2>

@if (!songReviews.Any() && !albumReviews.Any() && !artistReviews.Any())
{
    <div class="alert alert-success mt-3">No pending reviews!</div>
}

@* Song Reviews *@
@if (songReviews.Any())
{
    <h4 class="mt-4">Song Reviews (@songReviews.Count)</h4>
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr><th>Song</th><th>Customer</th><th>Rating</th><th>Review</th><th>Date</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in songReviews)
            {
                <tr>
                    <td>@r.Song?.Title</td>
                    <td>@r.Customer?.FirstName @r.Customer?.LastName</td>
                    <td>@r.Rating / 5</td>
                    <td>
                        <form method="post" asp-action="EditSongReviewText" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reviewId" value="@r.SongReviewID" />
                            <input type="text" name="reviewText" class="form-control form-control-sm"
                                   value="@r.ReviewText" maxlength="100" style="width:200px" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                        </form>
                    </td>
                    <td>@r.DateCreated.ToShortDateString()</td>
                    <td class="d-flex gap-1">
                        <form method="post" asp-action="ApproveSongReview">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reviewId" value="@r.SongReviewID" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form method="post" asp-action="RejectSongReview">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reviewId" value="@r.SongReviewID" />
                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

