@model BevosTunesMVC.Models.ActionConfirmationViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div style="max-width:640px">
    <h2>@Model.Heading</h2>
    <p class="text-muted mt-3">@Model.Message</p>

    @if (Model.Details.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var detail in Model.Details)
            {
                <li class="list-group-item">@detail</li>
            }
        </ul>
    }

    @if (string.IsNullOrWhiteSpace(Model.ConfirmController))
    {
        <form method="post" asp-action="@Model.ConfirmAction" class="mt-3">
            @Html.AntiForgeryToken()
            @foreach (var field in Model.HiddenFields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <button type="submit" class="btn @Model.ConfirmButtonClass">@Model.ConfirmButtonText</button>
            <a class="btn btn-secondary ms-2" href="@Model.CancelUrl">Cancel</a>
        </form>
    }
    else
    {
        <form method="post" asp-action="@Model.ConfirmAction" asp-controller="@Model.ConfirmController" class="mt-3">
            @Html.AntiForgeryToken()
            @foreach (var field in Model.HiddenFields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <button type="submit" class="btn @Model.ConfirmButtonClass">@Model.ConfirmButtonText</button>
            <a class="btn btn-secondary ms-2" href="@Model.CancelUrl">Cancel</a>
        </form>
    }
</div>
