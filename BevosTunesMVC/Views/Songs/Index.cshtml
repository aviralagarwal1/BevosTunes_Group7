@using BevosTunesMVC.Models
@model IEnumerable<BevosTunesMVC.Models.Song>
@{
    ViewData["Title"] = "Song Search";
    var allGenres = ViewBag.AllGenres as IEnumerable<Genre> ?? Enumerable.Empty<Genre>();
    var selectedIds = ViewBag.GenreIds as int[] ?? Array.Empty<int>();
    int total = ViewBag.TotalCount ?? 0;
    int display = ViewBag.DisplayCount ?? 0;
}

<h2>Song Search</h2>

<form method="get" asp-action="Index" class="mt-3">
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-md-3">
            <label for="songSearchTitle" class="form-label mb-1">Song title</label>
            <input id="songSearchTitle" type="text" name="title" class="form-control"
                   placeholder="Song title" value="@ViewBag.SearchTitle" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label for="songSearchArtist" class="form-label mb-1">Artist</label>
            <input id="songSearchArtist" type="text" name="artist" class="form-control"
                   placeholder="Artist name" value="@ViewBag.SearchArtist" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label for="songSearchAlbum" class="form-label mb-1">Album</label>
            <input id="songSearchAlbum" type="text" name="album" class="form-control"
                   placeholder="Album title" value="@ViewBag.SearchAlbum" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label for="songSortBy" class="form-label mb-1">Sort</label>
            <select id="songSortBy" name="sortBy" class="form-select">
                <option value="title" selected="@(ViewBag.SortBy == "title")">Title A-Z</option>
                <option value="title_desc" selected="@(ViewBag.SortBy == "title_desc")">Title Z-A</option>
                <option value="artist" selected="@(ViewBag.SortBy == "artist")">Artist A-Z</option>
                <option value="artist_desc" selected="@(ViewBag.SortBy == "artist_desc")">Artist Z-A</option>
                <option value="rating_desc" selected="@(ViewBag.SortBy == "rating_desc")">Rating High-Low</option>
                <option value="rating" selected="@(ViewBag.SortBy == "rating")">Rating Low-High</option>
            </select>
        </div>
    </div>
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-md-3">
            <label for="songRatingOp" class="form-label mb-1">Rating filter</label>
            <select id="songRatingOp" name="ratingOp" class="form-select">
                <option value="" selected="@(ViewBag.RatingOp == null)">Any rating</option>
                <option value="gt" selected="@(ViewBag.RatingOp == "gt")">Rating &gt;</option>
                <option value="lt" selected="@(ViewBag.RatingOp == "lt")">Rating &lt;</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="songRatingVal" class="form-label mb-1">Compare value</label>
            <input id="songRatingVal" type="number" name="ratingVal" class="form-control" placeholder="1.0 - 5.0"
                   min="1" max="5" step="0.1" value="@ViewBag.RatingVal" />
        </div>
        <div class="col-md-3 d-flex flex-column justify-content-end">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
        <div class="col-md-3 d-flex flex-column justify-content-end">
            <a class="btn btn-secondary w-100" asp-action="Index">Reset</a>
        </div>
    </div>
    <p class="form-text mb-3">Multiple keyword fields are combined with AND.</p>

    <div class="mb-3">
        <label class="form-label fw-semibold">Genres (select one or more):</label>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var genre in allGenres)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="genreIds" value="@genre.GenreID"
                           id="g_@genre.GenreID" @(selectedIds.Contains(genre.GenreID) ? "checked" : "") />
                    <label class="form-check-label" for="g_@genre.GenreID">@genre.Name</label>
                </div>
            }
        </div>
    </div>
</form>

<p class="text-muted">Displaying <strong>@display</strong> of <strong>@total</strong> songs</p>

@if (!Model.Any())
{
    <p>No songs match your search criteria.</p>
}
else
{
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Rating</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model)
            {
                var approved = song.SongReviews.Where(r => r.Status == ReviewStatus.Approved).ToList();
                var discount = song.Discounts.FirstOrDefault();
                var price = discount != null ? song.Price - discount.DiscountAmount : song.Price;
                <tr>
                    <td>@song.Title</td>
                    <td>@song.Artist?.Name</td>
                    <td>
                        @if (approved.Any())
                        {
                            @($"{approved.Average(r => r.Rating):0.0}")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>$@price.ToString("0.00")</td>
                    <td>
                        <a class="btn btn-sm btn-primary"
                           asp-action="Details" asp-route-id="@song.SongID">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
