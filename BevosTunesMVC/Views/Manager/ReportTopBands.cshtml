@{
    ViewData["Title"] = "Report: Top Selling Bands by Genre";
    var data = ViewBag.Data as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var rows = data.ToList();
    decimal totalRevenue = rows.Sum(item => (decimal)item.TotalRevenue);
    int totalSongSales = rows.Sum(item => (int)item.SongCount);
    int totalAlbumSales = rows.Sum(item => (int)item.AlbumCount);
}

<div class="admin-report-page admin-report-page-wide">
    <div class="admin-page-header">
        <div>
            <h2>Top Selling Bands by Genre</h2>
            <p class="admin-page-subtitle">One top-revenue artist per genre, excluding refunded orders.</p>
        </div>
    </div>

    <div class="admin-summary-grid">
        <div class="admin-summary-card">
            <div class="admin-summary-label">Genres Listed</div>
            <div class="admin-summary-value">@rows.Count</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Song Sales</div>
            <div class="admin-summary-value">@totalSongSales</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Album Sales</div>
            <div class="admin-summary-value">@totalAlbumSales</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Total Revenue</div>
            <div class="admin-summary-value">$@(totalRevenue.ToString("0.00"))</div>
        </div>
    </div>

    @if (rows.Any())
    {
        <div class="admin-table-wrap">
            <table class="table table-striped table-sm admin-report-table admin-report-table-wide">
                <colgroup>
                    <col class="report-col-number" />
                    <col class="report-col-genre" />
                    <col class="report-col-artist" />
                    <col class="report-col-metric" />
                    <col class="report-col-currency" />
                    <col class="report-col-metric" />
                    <col class="report-col-currency" />
                    <col class="report-col-primary" />
                    <col class="report-col-currency" />
                </colgroup>
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Genre</th>
                        <th>Artist</th>
                        <th class="text-end">Song Sales</th>
                        <th class="text-end">Song Revenue</th>
                        <th class="text-end">Album Sales</th>
                        <th class="text-end">Album Revenue</th>
                        <th>Album Breakdown</th>
                        <th class="text-end">Total Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int row = 1;
                    }
                    @foreach (var item in rows)
                    {
                        var songRevenue = (decimal)item.SongRevenue;
                        var albumRevenue = (decimal)item.AlbumRevenue;
                        var totalRowRevenue = (decimal)item.TotalRevenue;
                        var albumBreakdowns = ((IEnumerable<dynamic>)item.AlbumBreakdowns).ToList();
                        <tr>
                            <td>@(row++)</td>
                            <td>@item.Genre</td>
                            <td>@item.ArtistName</td>
                            <td class="text-end">@item.SongCount</td>
                            <td class="text-end">$@(songRevenue.ToString("0.00"))</td>
                            <td class="text-end">@item.AlbumCount</td>
                            <td class="text-end">$@(albumRevenue.ToString("0.00"))</td>
                            <td>
                                @if (albumBreakdowns.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var album in albumBreakdowns)
                                        {
                                            var albumRowRevenue = (decimal)album.Revenue;
                                            <li>@album.AlbumTitle: @album.Count purchase(s), $@(albumRowRevenue.ToString("0.00"))</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">No album sales</span>
                                }
                            </td>
                            <td class="text-end fw-bold">$@(totalRowRevenue.ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No sales data available.</div>
    }

    <a class="btn btn-secondary mt-3" asp-action="Dashboard" asp-controller="Employee">Back to Dashboard</a>
</div>
