@using BevosTunesMVC.Models
@model BevosTunesMVC.Models.Artist
@{
    ViewData["Title"] = "Edit Artist";
    var selectedGenres = ViewBag.SelectedGenres as int[] ?? Array.Empty<int>();
    string nameValue = ViewBag.NameValue ?? Model.Name;
}

<h2>Edit Artist</h2>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<form method="post" asp-action="EditArtist" class="mt-3" style="max-width:540px" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="artistId" value="@Model.ArtistID" />

    <div class="mb-3">
        <label class="form-label">Artist Name</label>
        <input type="text" name="name" class="form-control" value="@nameValue" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Genres</label>
        <div class="border rounded p-2" style="max-height:200px;overflow-y:auto">
            @foreach (Genre g in ViewBag.Genres)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="genreIds"
                           value="@g.GenreID" id="g@(g.GenreID)"
                           @(selectedGenres.Contains(g.GenreID) ? "checked" : "") />
                    <label class="form-check-label" for="g@(g.GenreID)">@g.Name</label>
                </div>
            }
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary ms-2" asp-action="Artists">Cancel</a>
</form>

<hr class="mt-4" style="max-width:540px" />
<h6>Add a New Genre</h6>
<form method="post" asp-action="AddGenre" style="max-width:400px" class="d-flex gap-2" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnAction" value="EditArtist" />
    <input type="hidden" name="returnController" value="Manager" />
    <input type="hidden" name="returnId" value="@Model.ArtistID" />
    <div class="flex-grow-1">
        <input type="text" name="name" class="form-control form-control-sm" placeholder="Genre name" required />
    </div>
    <button type="submit" class="btn btn-outline-secondary btn-sm">Add Genre</button>
</form>
