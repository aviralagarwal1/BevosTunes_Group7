@model IEnumerable<BevosTunesMVC.Models.Employee>
@{
    ViewData["Title"] = "Manage Employees";
    var employees = Model.ToList();
    int activeCount = employees.Count(e => e.IsActive);
    int managerCount = employees.Count(e => e.IsManager);
}

<div class="admin-page-header">
    <div>
        <h2>Manage Employees</h2>
        <p class="admin-page-subtitle">Hire, edit, promote, and reactivate staff accounts.</p>
    </div>
    <a class="btn btn-primary" asp-action="HireEmployee">Hire New Employee</a>
</div>

<div class="admin-summary-grid">
    <div class="admin-summary-card">
        <div class="admin-summary-label">Total Employees</div>
        <div class="admin-summary-value">@employees.Count</div>
    </div>
    <div class="admin-summary-card">
        <div class="admin-summary-label">Active Employees</div>
        <div class="admin-summary-value">@activeCount</div>
    </div>
    <div class="admin-summary-card">
        <div class="admin-summary-label">Managers</div>
        <div class="admin-summary-value">@managerCount</div>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>Name</th><th>Email</th><th>Phone</th><th>Manager?</th><th>Status</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr class="@(e.IsActive ? "" : "table-secondary text-muted")">
                    <td>@e.FirstName @e.LastName</td>
                    <td>@e.Email</td>
                    <td>@e.PhoneNumber</td>
                    <td>@(e.IsManager ? "Yes" : "No")</td>
                    <td>@(e.IsActive ? "Active" : "Fired")</td>
                    <td class="d-flex gap-1 flex-wrap">
                        <a class="btn btn-sm btn-primary" asp-action="EditEmployee" asp-route-id="@e.EmployeeID">Edit</a>
                        @if (e.IsActive)
                        {
                            @if (!e.IsManager)
                            {
                                <form method="post" asp-action="PromoteEmployee">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="employeeId" value="@e.EmployeeID" />
                                    <button type="submit" class="btn btn-sm btn-success">Promote</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-danger" asp-action="ConfirmFireEmployee" asp-route-employeeId="@e.EmployeeID">Fire</a>
                        }
                        else
                        {
                            <form method="post" asp-action="RehireEmployee">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@e.EmployeeID" />
                                <button type="submit" class="btn btn-sm btn-success">Rehire</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a class="btn btn-secondary mt-3" asp-action="Dashboard" asp-controller="Employee">Back to Dashboard</a>
