@model IEnumerable<BevosTunesMVC.Models.Song>
@{ ViewData["Title"] = "Manage Songs"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Songs</h2>
    <a class="btn btn-success btn-sm" asp-action="AddSong">+ Add Song</a>
</div>

<table class="table table-striped table-sm">
    <thead class="table-dark">
        <tr><th>Title</th><th>Artist</th><th>Price</th><th>Active?</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr class="@(s.IsActive ? "" : "table-secondary text-muted")">
                <td>@s.Title</td>
                <td>@s.Artist?.Name</td>
                <td>$@s.Price.ToString("0.00")</td>
                <td>@(s.IsActive ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditSong" asp-route-id="@s.SongID">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<p class="text-muted">@Model.Count() songs total</p>

<a class="btn btn-secondary" asp-action="Dashboard" asp-controller="Employee">Back to Dashboard</a>
