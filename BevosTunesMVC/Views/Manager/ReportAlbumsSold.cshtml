@using BevosTunesMVC.Models
@{
    ViewData["Title"] = "Report: Albums Sold";
    var data = ViewBag.Data as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var rows = data.ToList();
    decimal totalRevenue = rows.Sum(item => (decimal)item.Revenue);
    int totalUnits = rows.Sum(item => (int)item.Count);
    int purchasedAlbumCount = rows.Count(item => (int)item.Count > 0);
}

<div class="admin-report-page">
    <div class="admin-page-header">
        <div>
            <h2>Albums Sold Report</h2>
            <p class="admin-page-subtitle">Album purchases only, excluding refunded orders.</p>
        </div>
    </div>

    <div class="admin-summary-grid">
        <div class="admin-summary-card">
            <div class="admin-summary-label">Catalog Albums Listed</div>
            <div class="admin-summary-value">@rows.Count</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Albums Purchased</div>
            <div class="admin-summary-value">@purchasedAlbumCount</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Units Sold</div>
            <div class="admin-summary-value">@totalUnits</div>
        </div>
        <div class="admin-summary-card">
            <div class="admin-summary-label">Revenue</div>
            <div class="admin-summary-value">$@(totalRevenue.ToString("0.00"))</div>
        </div>
    </div>

    @if (rows.Any())
    {
        <div class="admin-table-wrap">
            <table class="table table-striped table-sm admin-report-table">
                <colgroup>
                    <col class="report-col-number" />
                    <col class="report-col-primary" />
                    <col class="report-col-secondary" />
                    <col class="report-col-metric" />
                    <col class="report-col-currency" />
                </colgroup>
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Album</th>
                        <th>Artist(s)</th>
                        <th class="text-end">Units Sold</th>
                        <th class="text-end">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int row = 1;
                    }
                    @foreach (var item in rows)
                    {
                        var artistNames = string.Join(", ",
                            ((IEnumerable<AlbumArtist>)item.Album.AlbumArtists).Select(aa => aa.Artist?.Name ?? ""));
                        var revenue = (decimal)item.Revenue;
                        <tr>
                            <td>@(row++)</td>
                            <td>@item.Album.Title</td>
                            <td>@artistNames</td>
                            <td class="text-end">@item.Count</td>
                            <td class="text-end">$@(revenue.ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No album sales data available.</div>
    }

    <a class="btn btn-secondary mt-3" asp-action="Dashboard" asp-controller="Employee">Back to Dashboard</a>
</div>
