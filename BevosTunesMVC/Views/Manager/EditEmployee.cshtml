@model BevosTunesMVC.Models.Employee
@{ ViewData["Title"] = "Edit Employee"; }

<h2>Edit Employee</h2>
<p class="text-muted">Email cannot be changed.</p>

@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<form method="post" asp-action="EditEmployee" class="mt-3" style="max-width:540px" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="employeeId" value="@Model.EmployeeID" />

    <div class="row">
        <div class="col mb-3">
            <label class="form-label">First Name</label>
            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" required />
        </div>
        <div class="col mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" name="lastName" class="form-control" value="@Model.LastName" required />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Email (read-only)</label>
        <input type="text" class="form-control" value="@Model.Email" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label">Phone Number</label>
        <input type="text" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Street</label>
        <input type="text" name="street" class="form-control" value="@Model.Street" required />
    </div>
    <div class="row">
        <div class="col mb-3">
            <label class="form-label">City</label>
            <input type="text" name="city" class="form-control" value="@Model.City" required />
        </div>
        <div class="col-3 mb-3">
            <label class="form-label">State</label>
            <input type="text" name="state" class="form-control" value="@Model.State" maxlength="2" required />
        </div>
        <div class="col mb-3">
            <label class="form-label">ZIP</label>
            <input type="text" name="zipCode" class="form-control" value="@Model.ZipCode" required />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary ms-2" asp-action="Employees">Cancel</a>
</form>

<hr class="mt-4" style="max-width:540px" />
<h5>Set Password</h5>
<form method="post" asp-action="SetEmployeePassword" style="max-width:400px" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="employeeId" value="@Model.EmployeeID" />
    <div class="mb-3">
        <label class="form-label">New Password</label>
        <input type="text" name="newPassword" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-secondary btn-sm">Set Password</button>
</form>
