@using BevosTunesMVC.Models
@{
    ViewData["Title"] = "Artist Details";
    var artist          = ViewBag.Artist as Artist;
    var approvedReviews = ViewBag.ApprovedReviews as List<ArtistReview> ?? new();
    double avgRating    = ViewBag.AvgRating ?? 0.0;
    bool isEmployee     = ViewBag.IsEmployee == true;
    bool isManager      = Context.Session.GetString("IsManager") == "true";
    bool isCustomer     = Context.Session.GetInt32("CustomerID").HasValue;
    bool purchased      = ViewBag.Purchased == true;
    var existingReview  = ViewBag.ExistingReview as ArtistReview;
}

<h2>@artist?.Name</h2>

<dl class="row mt-3">
    <dt class="col-sm-3">Genre(s)</dt>
    <dd class="col-sm-9">
        @string.Join(", ", artist?.ArtistGenres?.Select(ag => ag.Genre?.Name) ?? Enumerable.Empty<string>())
    </dd>

    <dt class="col-sm-3">Average Rating</dt>
    <dd class="col-sm-9">
        @if (approvedReviews.Any())
        { @($"{avgRating:0.0} / 5 ({approvedReviews.Count} review{(approvedReviews.Count == 1 ? "" : "s")})") }
        else
        { <span class="text-muted">No reviews yet</span> }
    </dd>
</dl>

@if (isManager)
{
    <div class="mb-3">
        <a class="btn btn-outline-primary" asp-controller="Manager" asp-action="EditArtist" asp-route-id="@artist?.ArtistID">Edit Artist</a>
    </div>
}

@* Albums *@
@if (artist?.AlbumArtists?.Any() == true)
{
    <h4 class="mt-4">Albums</h4>
    <table class="table table-sm table-striped">
        <thead class="table-dark"><tr><th>Album</th><th>Price</th></tr></thead>
        <tbody>
            @foreach (var aa in artist.AlbumArtists)
            {
                <tr>
                    <td>
                        <a asp-controller="Albums" asp-action="Details" asp-route-id="@aa.AlbumID">
                            @aa.Album?.Title
                        </a>
                    </td>
                    <td>$@aa.Album?.Price.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

@* Songs *@
@if (artist?.Songs?.Any() == true)
{
    <h4 class="mt-4">Songs</h4>
    <table class="table table-sm table-striped">
        <thead class="table-dark"><tr><th>Title</th><th>Price</th></tr></thead>
        <tbody>
            @foreach (var song in artist.Songs.Where(s => s.IsActive))
            {
                <tr>
                    <td>
                        <a asp-controller="Songs" asp-action="Details" asp-route-id="@song.SongID">
                            @song.Title
                        </a>
                    </td>
                    <td>$@song.Price.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

@* Reviews *@
@if (approvedReviews.Any())
{
    <h4 class="mt-4">Reviews</h4>
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr><th>Customer</th><th>Rating</th><th>Review</th><th>Date</th>
                @if (isCustomer){ <th></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var review in approvedReviews)
            {
                bool isOwn = Context.Session.GetInt32("CustomerID") == review.CustomerID;
                <tr>
                    <td>@review.Customer?.FirstName @review.Customer?.LastName</td>
                    <td>@review.Rating / 5</td>
                    <td>@review.ReviewText</td>
                    <td>@review.DateCreated.ToShortDateString()</td>
                    @if (isOwn)
                    {
                        <td>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Artists" asp-action="ConfirmDeleteReviewText" asp-route-reviewId="@review.ArtistReviewID">Delete text</a>
                        </td>
                    }
                    else if (isCustomer) { <td></td> }
                </tr>
            }
        </tbody>
    </table>
}

@* Submit / Edit Review *@
@if (isCustomer && !isEmployee && purchased)
{
    <div class="card mt-4" style="max-width:500px">
        <div class="card-body">
            @if (existingReview == null)
            {
                <h5 class="card-title">Write a Review</h5>
                <form method="post" asp-controller="Artists" asp-action="AddReview" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="artistId" value="@artist?.ArtistID" />
                    <div class="mb-2">
                        <label class="form-label">Rating (1-5) <span class="text-danger">*</span></label>
                        <select name="rating" class="form-select" style="width:100px" required>
                            @for (int i = 1; i <= 5; i++) { <option value="@i">@i</option> }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Review (optional, max 100 chars)</label>
                        <textarea name="reviewText" class="form-control" maxlength="100" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Submit Review</button>
                </form>
            }
            else
            {
                <h5 class="card-title">Edit Your Review
                    <span class="badge @(existingReview.Status == ReviewStatus.Approved ? "bg-success" : "bg-warning text-dark") ms-2 fs-6">
                        @existingReview.Status
                    </span>
                </h5>
                <form method="post" asp-controller="Artists" asp-action="EditReview" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reviewId" value="@existingReview.ArtistReviewID" />
                    <div class="mb-2">
                        <label class="form-label">Rating (1-5)</label>
                        <select name="rating" class="form-select" style="width:100px" required>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <option value="@i" selected="@(existingReview.Rating == i)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Review text (optional, max 100 chars)</label>
                        <textarea name="reviewText" class="form-control" maxlength="100" rows="3">@existingReview.ReviewText</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Update Review</button>
                </form>
            }
        </div>
    </div>
}

<div class="mt-4">
    <a class="btn btn-secondary" asp-action="Index">Back to Artist Search</a>
</div>
