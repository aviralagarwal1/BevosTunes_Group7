@using BevosTunesMVC.Models
@model IEnumerable<BevosTunesMVC.Models.Artist>
@{
    ViewData["Title"] = "Artist Search";
    var allGenres = ViewBag.AllGenres as IEnumerable<Genre> ?? Enumerable.Empty<Genre>();
    var selectedIds = ViewBag.GenreIds as int[] ?? Array.Empty<int>();
    int total = ViewBag.TotalCount ?? 0;
    int display = ViewBag.DisplayCount ?? 0;
}

<h2>Artist Search</h2>

<form method="get" asp-action="Index" class="mt-3">
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <input type="text" name="keyword" class="form-control" placeholder="Artist name"
                   value="@ViewBag.Keyword" />
        </div>
        <div class="col-md-2">
            <select name="ratingOp" class="form-select">
                <option value="">Any rating</option>
                <option value="gt" selected="@(ViewBag.RatingOp == "gt")">Rating &gt;</option>
                <option value="lt" selected="@(ViewBag.RatingOp == "lt")">Rating &lt;</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" name="ratingVal" class="form-control" placeholder="1.0 - 5.0"
                   min="1" max="5" step="0.1" value="@ViewBag.RatingVal" />
        </div>
        <div class="col-md-2">
            <select name="sortBy" class="form-select">
                <option value="name" selected="@(ViewBag.SortBy == "name")">Name A-Z</option>
                <option value="name_desc" selected="@(ViewBag.SortBy == "name_desc")">Name Z-A</option>
                <option value="rating_desc" selected="@(ViewBag.SortBy == "rating_desc")">Rating High-Low</option>
                <option value="rating" selected="@(ViewBag.SortBy == "rating")">Rating Low-High</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Genres:</label>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var genre in allGenres)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="genreIds" value="@genre.GenreID"
                           id="rg_@genre.GenreID" @(selectedIds.Contains(genre.GenreID) ? "checked" : "") />
                    <label class="form-check-label" for="rg_@genre.GenreID">@genre.Name</label>
                </div>
            }
        </div>
    </div>
</form>

<p class="text-muted">Displaying <strong>@display</strong> of <strong>@total</strong> artists</p>

@if (!Model.Any())
{
    <p>No artists match your search criteria.</p>
}
else
{
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Genre(s)</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var artist in Model)
            {
                var approved = artist.ArtistReviews.Where(r => r.Status == ReviewStatus.Approved).ToList();
                <tr>
                    <td>@artist.Name</td>
                    <td>@string.Join(", ", artist.ArtistGenres.Select(ag => ag.Genre?.Name))</td>
                    <td>
                        @if (approved.Any())
                        {
                            @($"{approved.Average(r => r.Rating):0.0}")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-primary"
                           asp-action="Details" asp-route-id="@artist.ArtistID">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
