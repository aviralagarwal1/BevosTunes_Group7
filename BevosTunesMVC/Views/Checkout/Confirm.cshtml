@using BevosTunesMVC.Models
@{
    ViewData["Title"] = "Confirm Order";
    var cartItems = ViewBag.CartItems as List<CartItem> ?? new();
    var card = ViewBag.Card as CreditCard;
    bool isGift = ViewBag.IsGift == true;
    var recipient = ViewBag.GiftRecipient as Customer;
    var ownedSongIds = ViewBag.OwnedSongIds as HashSet<int> ?? new();
    var ownedAlbumIds = ViewBag.OwnedAlbumIds as HashSet<int> ?? new();
    bool hasOwnedItems = ViewBag.HasOwnedItems == true;
    bool allItemsOwned = ViewBag.AllItemsOwned == true;
    decimal subtotal = ViewBag.Subtotal ?? 0m;
    decimal tax = ViewBag.Tax ?? 0m;
    decimal total = ViewBag.Total ?? 0m;
}

<h2>Confirm Your Order</h2>
<p class="text-muted">Please review your order before confirming.</p>

@if (hasOwnedItems)
{
    <div class="alert alert-info">
        Some items in your cart are already in your library.
        Please check your <a asp-controller="Account" asp-action="MyMusic">My Music</a> page. You will not be charged by Bevo's Tunes again.
    </div>
}

<h5 class="mt-3">Items</h5>
<table class="table table-sm purchase-flow-table">
    <thead class="table-dark"><tr><th>Item</th><th>Price</th></tr></thead>
    <tbody>
        @foreach (var ci in cartItems)
        {
            decimal price;
            string name;
            if (ci.Song != null)
            {
                var d = ci.Song.Discounts.FirstOrDefault();
                price = d != null ? ci.Song.Price - d.DiscountAmount : ci.Song.Price;
                name = ci.Song.Title;
            }
            else if (ci.Album != null)
            {
                var d = ci.Album.Discounts.FirstOrDefault();
                price = d != null ? ci.Album.Price - d.DiscountAmount : ci.Album.Price;
                name = ci.Album.Title;
            }
            else
            {
                continue;
            }
            bool isAlreadyOwned = !isGift
                && ((ci.SongID.HasValue && ownedSongIds.Contains(ci.SongID.Value))
                || (ci.AlbumID.HasValue && ownedAlbumIds.Contains(ci.AlbumID.Value)));
            <tr>
                <td>
                    @name
                    @if (isAlreadyOwned)
                    {
                        <span class="text-muted">(You already own this item! Check <a asp-controller="Account" asp-action="MyMusic">My Music</a>)</span>
                    }
                </td>
                <td>$@((isAlreadyOwned ? 0m : price).ToString("0.00"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><td class="text-end fw-semibold">Subtotal:</td><td>$@subtotal.ToString("0.00")</td></tr>
        <tr><td class="text-end fw-semibold">Tax (8.25%):</td><td>$@tax.ToString("0.00")</td></tr>
        <tr><td class="text-end fw-bold">Total:</td><td class="fw-bold">$@total.ToString("0.00")</td></tr>
    </tfoot>
</table>

<dl class="row mt-3">
    <dt class="col-sm-3">Payment</dt>
    <dd class="col-sm-9">
        @if (card != null)
        {
            @($"**** **** **** {card.CardNumber[^4..]} - {card.DisplayCardType}")
        }
    </dd>

    @if (isGift && recipient != null)
    {
        <dt class="col-sm-3">Gift To</dt>
        <dd class="col-sm-9">@recipient.FirstName @recipient.LastName (@recipient.Email)</dd>
    }
</dl>

<form method="post" asp-action="Process" class="mt-3">
    @Html.AntiForgeryToken()
    @if (allItemsOwned)
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="MyMusic">Go to My Music</a>
    }
    else
    {
        <button type="submit" class="btn btn-success">Confirm &amp; Place Order</button>
    }
    <a class="btn btn-secondary ms-2" asp-action="Index">Go Back</a>
</form>
